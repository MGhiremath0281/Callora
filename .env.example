# ---------------------------------------------------------------------------
# Copy this file to `.env` in the repository root and fill in your secrets.
#
#     cp .env.example .env
#
# `.env` is gitignored and is never committed. The backend reads it from the
# repository root no matter which directory you start it from; Docker Compose
# reads it from the same place. Shell variables override anything set here.
# ---------------------------------------------------------------------------

# --- Database (optional; the Docker Compose default is used otherwise) ------
# CALLORA_DATABASE_URL=postgresql+psycopg2://callora:callora@localhost:5433/callora

# --- API authentication ----------------------------------------------------
# Comma-separated "business_id:api_key" pairs.
# CALLORA_API_KEYS=biz_001:dev-key-biz-001,biz_002:dev-key-biz-002

# --- Outbound voice agent (Bolna) -----------------------------------------
# The API key alone is enough to exercise the flow: with outbound calling
# disabled the provider is never contacted. It only matters once
# CALLORA_VOICE_ENABLE_OUTBOUND_CALLS=true.
CALLORA_BOLNA_API_KEY=
# The Bolna agent id (the prompt / welcome message / language you built).
CALLORA_BOLNA_DEFAULT_AGENT_ID=
# The caller id in E.164. Optional: leave it empty and Bolna places the
# call through the telephony provider configured on the agent (Vobiz,
# Twilio, Plivo, ...). Set it only to a number your provider account
# owns — Bolna rejects a number it does not know.
CALLORA_BOLNA_DEFAULT_FROM_NUMBER=
# Shared secret for webhook signature verification (optional).
CALLORA_BOLNA_WEBHOOK_SECRET=
# IMPORTANT: the Bolna agent itself needs a webhook URL, otherwise Bolna
# never pushes an execution event and the call only moves through the
# reconciliation sweep. Point it at
# https://<your-host>/api/v1/voice/webhooks/bolna/execution

# --- Master switch for real outbound calling -------------------------------
# Keep this false until the compliance policy and the provider account are
# ready. While it is false every accepted call is recorded as "simulated"
# and no provider is contacted.
CALLORA_VOICE_ENABLE_OUTBOUND_CALLS=false

# --- Call status reconciliation --------------------------------------------
# The provider webhook is the fast path; the reconciliation sweep is the
# safety net for the webhooks that never arrive (the Bolna agent without a
# webhook_url, a dropped request, a rejected payload). It polls the provider
# for the status of the calls Callora knows about.
#
# How often a single call may be checked with the provider (seconds).
# CALLORA_VOICE_STATUS_POLL_INTERVAL_SECONDS=60
# How often the background worker runs the sweep. 0 disables it.
# CALLORA_VOICE_STATUS_SYNC_INTERVAL_SECONDS=60
# How many calls are checked in one sweep.
# CALLORA_VOICE_STATUS_SYNC_MAX_CALLS_PER_SWEEP=50
# How long a call may stay in a pre-dial state (scheduled / queued) before
# the timeout policy applies. The provider is always asked first: the call
# is only closed when the provider confirms that it is still waiting. A call
# that is talking to somebody is never closed this way.
# CALLORA_VOICE_SCHEDULED_CALL_TIMEOUT_SECONDS=900
# What the timeout policy does: "fail" closes the call as failed,
# "keep_polling" only reports it and leaves it in place.
# CALLORA_VOICE_STUCK_CALL_TIMEOUT_ACTION=fail

# --- Duplicate-call cooldown ------------------------------------------------
# Minimum gap between two calls to the same lead. The value is in seconds:
# the production default is 3600 (60 minutes); a local development
# deployment can shorten it to e.g. 60 so a test call can be repeated
# quickly. 0 disables the cooldown.
#
# This never weakens the in-flight guard: while Bolna still reports the
# previous call as queued, ringing or active, a second call to the same
# lead is refused regardless of this value.
# CALLORA_VOICE_DUPLICATE_CALL_COOLDOWN_SECONDS=3600

# --- Local development only -------------------------------------------------
# NEVER set these in production: they relax a compliance rule.
#
# CALLORA_ENVIRONMENT marks the deployment. Anything other than
# "local"/"development"/"dev"/"test"/"testing" is treated as production,
# and the override below is then refused (and logged).
# CALLORA_ENVIRONMENT=local
#
# Skips the daily per-lead and per-business call quotas so a local
# integration can be tested repeatedly. Consent, DND, the calling window,
# the duplicate-call protection, the concurrency cap and the provider check
# all keep blocking as usual.
# CALLORA_DISABLE_CALL_QUOTAS=true

# --- Redis (accelerator only; never the source of truth) ------------------
# CALLORA_REDIS_URL=redis://localhost:6379/0
# CALLORA_REDIS_ENABLED=true

# --- Post-call AI workflow -------------------------------------------------
# "groq" calls a model; "null" degrades to the provider payload.
# CALLORA_VOICE_LLM_PROVIDER=groq
# GROQ_API_KEY=

# --- Logging ---------------------------------------------------------------
# CALLORA_LOG_LEVEL=INFO
