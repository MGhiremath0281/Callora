# ---------------------------------------------------------------------------
# Copy this file to `.env` in the repository root and fill in your secrets.
#
#     cp .env.example .env
#
# `.env` is gitignored and is never committed. The backend reads it from the
# repository root no matter which directory you start it from; Docker Compose
# reads it from the same place. Shell variables override anything set here.
# ---------------------------------------------------------------------------

# --- Database (optional; the Docker Compose default is used otherwise) ------
# CALLORA_DATABASE_URL=postgresql+psycopg2://callora:callora@localhost:5433/callora

# --- API authentication ----------------------------------------------------
# Comma-separated "business_id:api_key" pairs.
# CALLORA_API_KEYS=biz_001:dev-key-biz-001,biz_002:dev-key-biz-002

# --- Outbound voice agent (Bolna) -----------------------------------------
# The API key alone is enough to exercise the flow: with outbound calling
# disabled the provider is never contacted. It only matters once
# CALLORA_VOICE_ENABLE_OUTBOUND_CALLS=true.
CALLORA_BOLNA_API_KEY=
# The Bolna agent id (the prompt / welcome message / language you built).
CALLORA_BOLNA_DEFAULT_AGENT_ID=
# The caller id in E.164.
CALLORA_BOLNA_DEFAULT_FROM_NUMBER=
# Shared secret for webhook signature verification (optional).
CALLORA_BOLNA_WEBHOOK_SECRET=

# --- Master switch for real outbound calling -------------------------------
# Keep this false until the compliance policy and the provider account are
# ready. While it is false every accepted call is recorded as "simulated"
# and no provider is contacted.
CALLORA_VOICE_ENABLE_OUTBOUND_CALLS=false

# --- Redis (accelerator only; never the source of truth) ------------------
# CALLORA_REDIS_URL=redis://localhost:6379/0
# CALLORA_REDIS_ENABLED=true

# --- Post-call AI workflow -------------------------------------------------
# "groq" calls a model; "null" degrades to the provider payload.
# CALLORA_VOICE_LLM_PROVIDER=groq
# GROQ_API_KEY=

# --- Logging ---------------------------------------------------------------
# CALLORA_LOG_LEVEL=INFO
